# GLPI API Live Environment Test Configuration
# Copy this file to .env and adjust the values for your GLPI instance.
# Usage: npm run test:live   OR   node scripts/test-live.mjs

# Base GLPI API URL (must point to api.php)
GLPI_API_URL=https://glpi.example.com/api.php

# OAuth2 Authentication Type: password | client_credentials | authorization_code
GLPI_AUTH_TYPE=password

# OAuth2 Client Credentials (from GLPI Setup > General > API / OAuth)
GLPI_CLIENT_ID=your-oauth-client-id
GLPI_CLIENT_SECRET=your-oauth-client-secret

# User Credentials (required when GLPI_AUTH_TYPE=password)
GLPI_USERNAME=technician
GLPI_PASSWORD=secure-password

# Optional: OAuth Scope (default: all)
# GLPI_SCOPE=all

# Optional: Proxy Configuration (e.g., corporate HTTP proxy)
# GLPI_PROXY=http://proxy.corp.internal:8080
# Or use standard environment variables:
# HTTP_PROXY=http://proxy.corp.internal:8080
# HTTPS_PROXY=http://proxy.corp.internal:8080

# Optional: Session Scoping
# GLPI_ENTITY=0
# GLPI_PROFILE=4
# GLPI_LANGUAGE=en_GB

# Clean up created test entities (ticket, document) when finished (true/false)
GLPI_CLEANUP=true
