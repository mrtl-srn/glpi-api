{
  "name": "glpi-api",
  "version": "2.0.0",
  "description": "Node module for GLPI REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "author": "Martial Séron <martial.seron@alturing.eu>",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node scripts/test-live.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartialSeron/glpi-api.git"
  },
  "bugs": {
    "url": "https://github.com/MartialSeron/glpi-api/issues"
  },
  "homepage": "https://github.com/MartialSeron/glpi-api#readme",
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^9.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.4"
  }
}
